# Cloudflare Pages - regras de header do site estatico
# (o GitHub Pages ignora este arquivo; ele passa a valer no deploy do Cloudflare)

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # HSTS sem includeSubDomains: o dominio e proprio (5gserralheria.com.br), mas
  # so o www esta em producao. Incluir subdominios forcaria HTTPS em qualquer
  # outro que venha a existir, antes de haver certificado para ele.
  Strict-Transport-Security: max-age=31536000
  # O site nao usa nenhuma destas APIs; negar reduz a superficie de ataque
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()

# Cache imutavel para imagens WebP
/assets/img/*
  Cache-Control: public, max-age=31536000, immutable

# Cache para CSS e JS
/assets/css/*
  Cache-Control: public, max-age=31536000, immutable

/assets/js/*
  Cache-Control: public, max-age=31536000, immutable

# Paginas HTML (revalidacao curta)
/*.html
  Cache-Control: public, max-age=3600, must-revalidate
